# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있으므로 절대 커밋되지 않습니다.

# 텔레그램 봇 토큰 (@BotFather 에서 /newbot 으로 발급)
TELEGRAM_TOKEN=

# 브리핑을 수신할 채팅 ID
# 봇에게 아무 메시지나 보낸 뒤 아래에서 확인:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Google Gemini API 키 (https://aistudio.google.com/apikey)
# 미설정 시 AI 분석 없이 시장 데이터만 전송됩니다.
# ⚠️ 2026-08 이후 신규 발급 키는 gemini-2.5 계열을 사용할 수 없습니다.
#    현재 모델은 gemini-3.6-flash (src/ai_analyzer.py 의 MODEL_NAME).
GEMINI_API_KEY=
